{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "jvm_memory_used_bytes", "legendFormat": "{{area}}", "refId": "A" } ],
      "title": "JVM Memory Used",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 90 } ] } } },
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": [ "lastNotNull" ] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "process_cpu_usage * 100", "refId": "A" } ],
      "title": "CPU Usage %",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": [ "mean", "max" ] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(http_server_requests_seconds_count[1m])", "legendFormat": "{{method}} {{uri}}", "refId": "A" } ],
      "title": "HTTP Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": [ "mean", "p95", "max" ] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket[5m]))", "legendFormat": "p95 {{method}} {{uri}}", "refId": "A" } ],
      "title": "HTTP Latency (p95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [ { "options": { "1": { "text": "UP", "color": "green" } }, "type": "value" } ] } },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 8 },
      "id": 5,
      "options": { "colorMode": "background", "reduceOptions": { "calcs": [ "lastNotNull" ] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "up", "refId": "A" } ],
      "title": "App Status",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 8 },
      "id": 6,
      "options": { "reduceOptions": { "calcs": [ "lastNotNull" ] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "jvm_threads_live_threads", "refId": "A" } ],
      "title": "Active Threads",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 8 },
      "id": 7,
      "options": { "reduceOptions": { "calcs": [ "lastNotNull" ] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "jvm_memory_max_bytes{area=\"heap\"}", "refId": "A" } ],
      "title": "Max Heap",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 16 },
      "id": 8,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [ { "datasource": { "type": "loki", "uid": "loki" }, "expr": "{job=\"vendnet\"}", "refId": "A" } ],
      "title": "Application Logs",
      "type": "logs"
    }
  ],
  "refresh": "10s",
